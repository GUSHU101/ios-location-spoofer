#!name=iOS Location Spoofer - Experimental Seven Hosts (Surge)
#!desc=实验模式：列出7个精确的HTTPS解密Host，仅对6个候选WLOC Host的/clls/wloc做脚本改写，绝不改写gsp10位置上报接口。
# EXPERIMENTAL: gsp10-ssl.apple.com can carry sensitive device location uploads.
# Upload paths /hcy/pbcwloc, /pds/pd, /hvr/trc are NOT processed by scripts.
# MITM still decrypts by hostname. Only use on devices you own and with consent.
# gs-loc-new.apple.com is not a documented Apple WLOC API. No GPS guarantee.
# Never enable this alongside another profile.
#!homepage=https://github.com/GUSHU101/ios-location-spoofer
#!arguments=latitude:37.3349,longitude:-122.00902,altitude:530,horizontalAccuracy:39,verticalAccuracy:1000,configUrl:,debug:false

[Script]
iOS Location Spoofer Prepare = type=http-request,pattern=^https:\/\/(?:gs-loc(?:-cn|-new)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=0,timeout=3,script-path=https://raw.githubusercontent.com/GUSHU101/ios-location-spoofer/main/location-spoofer.js,argument=mode=prepare&debug=false
iOS Location Spoofer = type=http-response,pattern=^https:\/\/(?:gs-loc(?:-cn|-new)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/GUSHU101/ios-location-spoofer/main/location-spoofer.js,argument=mode=response&latitude={{{latitude}}}&longitude={{{longitude}}}&horizontalAccuracy={{{horizontalAccuracy}}}&verticalAccuracy={{{verticalAccuracy}}}&altitude={{{altitude}}}&configUrl={{{configUrl}}}&debug={{{debug}}}

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com, gs-loc-new.apple.com, gsp10-ssl.apple.com
